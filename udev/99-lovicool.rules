# lovingcool-control udev rules
# ======================
# Allows non-root users to access the AIO controller's USB interface.
#
# INSTALL:
#   sudo cp udev/99-lovicool.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#   (then unplug/replug the AIO, or reboot)
#
# IMPORTANT: Replace idVendor / idProduct below with your actual device's
# values once found via: python tools/enumerate.py

# This unit: RT-Thread RTOS USB-CDC stack — enumerates as a plain USB-serial
# (CDC-ACM) virtual COM port, not HID. Most distros already default
# /dev/ttyACM* to mode 0666 owned by group "dialout" (and this rule is
# redundant if you're already in that group), but it's kept here for
# portability and to give the port a stable symlink.
SUBSYSTEM=="tty", ATTRS{idVendor}=="33c3", ATTRS{idProduct}=="7788", MODE="0666", GROUP="dialout", TAG+="uaccess", SYMLINK+="lovicool"

# If your unit instead enumerates as HID (different model/firmware),
# uncomment and fill in the matching rules below:
# SUBSYSTEM=="usb", ATTRS{idVendor}=="0000", ATTRS{idProduct}=="0000", MODE="0666", TAG+="uaccess"
# SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0000", ATTRS{idProduct}=="0000", MODE="0666", TAG+="uaccess"

# If your AIO enumerates as multiple interfaces (e.g. one for LCD, one for
# RGB), they will usually share the same idVendor/idProduct, so one rule
# generally covers both — but add more lines here if you discover a second
# VID:PID pair for a sub-controller.
