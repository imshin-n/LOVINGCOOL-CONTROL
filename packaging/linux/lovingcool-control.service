# lovingcool-control :: packaging/linux/lovingcool-control.service
# ================================================================
# systemd --user unit for lovingcool-controld, the background service that
# owns the cooler's screen. It has no GUI and needs no display, so it can
# start at login before the desktop is up. While the cooler is unplugged it
# just waits, and it restores the last image/GIF/video/text/scene (and
# brightness) whenever the device appears.
#
# Install with packaging/linux/install_service.sh.
#
#   lovingcool-ctl status                     what's connected and showing
#   systemctl --user restart lovingcool-control
#   journalctl --user -u lovingcool-control -f

[Unit]
Description=LOVINGCOOL-CONTROL screen service
Documentation=https://github.com/imshin-n/LOVINGCOOL-CONTROL
# Back off if something is persistently broken instead of hammering the device.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/lovingcool-controld
Restart=on-failure
RestartSec=5
# The panel's JPEG encoding is the only real work; keep it from competing with games.
Nice=5

[Install]
WantedBy=default.target
