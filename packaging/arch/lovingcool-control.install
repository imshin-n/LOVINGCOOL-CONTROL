post_install() {
  cat <<'MSG'
==> LOVINGCOOL-CONTROL installed.
    Start the screen service for your user (not as root):
        systemctl --user enable --now lovingcool-control
    Then unplug/replug the cooler once so the udev rule applies.
    Control it with the "LOVINGCOOL-CONTROL" app or `lovingcool-ctl --help`.

    If you used packaging/linux/install_service.sh before, remove that copy
    first so it doesn't shadow this one:
        packaging/linux/uninstall_service.sh
MSG
}

post_upgrade() {
  echo "==> Restart the service to pick up the new version:  systemctl --user restart lovingcool-control"
}

pre_remove() {
  echo "==> Stop the service in your session if it's running:  systemctl --user disable --now lovingcool-control"
}
